{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend/",
            "framework": "vite"
        },
        "backend": {
            "root": "backend/",
            "framework": "fastapi",
            "entrypoint": "app.main:app"
        }
    },
    "rewrites": [
        {
            "source": "/detect/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/detect",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/detections/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/detections",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/dashboard/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/dashboard",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/analytics/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/analytics",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/model/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/model",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/health",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/static/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}